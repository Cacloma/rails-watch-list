<%= @list.name %>
<% @list.bookmarks.includes(:movie).each do |bookmark| %>
<%= bookmark.movie.title %> — <%= bookmark.comment %>
<%= button_to "Supprimer", bookmark_path(bookmark), method: :delete, data: { confirm: "Supprimer ce bookmark ?" } %>
<% end %>
<%= form_with model: @bookmark, url: list_bookmarks_path(@list) do |f| %>
<%= f.label :movie_id, "Film" %>
<%= f.collection_select :movie_id, Movie.all, :id, :title, prompt: "Choisir un film" %>
<%= f.label :comment %>
<%= f.text_field :comment %>
<%= f.submit "Ajouter" %>
<% end %>
